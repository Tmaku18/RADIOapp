{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "setupFiles": ["<rootDir>/test/setup-e2e.ts"],
  "moduleNameMapper": {
    "^music-metadata$": "<rootDir>/test/mocks/music-metadata.js",
    "^ffmpeg-static$": "<rootDir>/test/mocks/ffmpeg-static.js",
    "^uuid$": "<rootDir>/test/mocks/uuid.js"
  },
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testTimeout": 60000,
  "maxWorkers": 1
}
